# ---------------------------------------------------------------------------
# Sales API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the two environments apart.
APP_ENV=production

# AICOUNTLY portal auth API. Leave unset unless you are pointing at a
# non-standard portal — my.aicountly.com serves BOTH production and sandbox.
# (sandbox.aicountly.com is a login redirect only; it does not serve seskey or
# validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Comma-separated origins allowed to call this API cross-origin.
# Both deployed environments are same-origin with their app, so leave this
# empty in production. It exists for `npm run dev` against a deployed API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Sales database (PostgreSQL)
#
# This product's OWN database, holding only what Sales owns: quotations, orders,
# price books, approvals. It is never pointed at the Books, Inventory or Manage
# database — those are read and written through their HTTP APIs.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
# Optional: a non-public schema.
# DB_SCHEMA=

# Which product this is, sent as X-Saas-Origin so the apps we call do not call
# us back inside our own request (see src/CrossServiceCallContext.php).
APP_PRODUCT_KEY=sales

# ---------------------------------------------------------------------------
# Live API endpoints
#
# Leave unset in the deployed environments: the base is derived from our own
# hostname, so sandbox talks to sandbox without a second set of variables to
# keep in step. Set them for local development.
# ---------------------------------------------------------------------------
# BOOKS_API_BASE=https://books.gh.aicountly.com
# INVENTORY_API_BASE=https://inventory.gh.aicountly.com
# MANAGE_API_BASE=https://manage.gh.aicountly.com
# CONTACTS_API_BASE=https://contacts.gh.aicountly.com

# ---------------------------------------------------------------------------
# Service keys
#
# Ours, for calling Books and Inventory as a product rather than as a person.
# Both must be registered on the other side (Books' SALES_SERVICE_KEY and
# Inventory's INVENTORY_SERVICE_KEYS entry for `sales`).
# ---------------------------------------------------------------------------
BOOKS_SERVICE_KEY=CHANGE_ME
INVENTORY_SERVICE_KEY=CHANGE_ME

# Keys OTHER products present when they call us, as app:key pairs.
# A key left as CHANGE_ME never authenticates anything.
# SERVICE_KEYS=pos:CHANGE_ME,billing:CHANGE_ME
